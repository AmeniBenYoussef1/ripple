COMINTY_API_KEY=
COMINTY_USER_ID=
# COMINTY_BASE_URL=https://ds.cominty.com

COMINTY_SKILL_CONTRACTS=
COMINTY_AGENT_IMPACT=
COMINTY_AGENT_FINDER=
COMINTY_AGENT_REPLANNER=
COMINTY_AGENT_COORDINATOR=

# replay saved agent runs instead of spending credits
DEMO_MODE=false

# ---- public deployment (see DEPLOY.md) ----
# RIPPLE_PUBLIC=true                    # visitors work on their own events; shared events are read-only
# RIPPLE_REPLAY_EVENTS=demo             # events that always replay their recordings
# RIPPLE_CROSS_SITE_COOKIE=true         # frontend and backend on different sites
# RIPPLE_CORS_ORIGINS=https://your-app.vercel.app
# RIPPLE_DATA_DIR=/var/data             # events and usage on a persistent disk
# RIPPLE_VISITOR_ANALYSES=1             # per visitor (cookie/id and IP), per day
# RIPPLE_VISITOR_PROBLEMS=5
# RIPPLE_DAILY_BUDGET_USD=2             # all visitors together, from real Cominty costs
# RIPPLE_VISITOR_TTL_HOURS=24           # visitor events and uploads are deleted after this
# RIPPLE_VISITOR_MAX_FILE_MB=5
# RIPPLE_OWNER_TOKEN=                   # a long random secret; open /start?owner=<token> once
# RIPPLE_OWNER_BUDGET_USD=5
# RIPPLE_SHOW_DEV_INFO=true             # local development only: server, event id, how to switch modes
